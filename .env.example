# ── Server & Application ──
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173/admin

# ── MongoDB Database (Atlas Cluster or local replica set) ──
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kairo_db?retryWrites=true&w=majority

# ── JWT Authentication Secrets ──
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_placeholder
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_signing_secret_placeholder

# ── Cloudinary Media Storage ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=your_cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_placeholder

# ── Razorpay Payment Gateway ──
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# ── Brevo Transactional Email (Production) ──
BREVO_API_KEY=your_brevo_api_key_placeholder
BREVO_SENDER_NAME="KAIRO Concierge"
BREVO_SENDER_EMAIL=concierge@kairo-horology.com

# ── SMTP Email (Local Development / Fallback) ──
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_placeholder
SMTP_PASS=your_smtp_password_placeholder
EMAIL_FROM=concierge@kairo-horology.com

# ── Branded Media & URLs ──
EMAIL_LOGO_URL=https://res.cloudinary.com/kairo/image/upload/v1/brand/kairo-logo.png
APP_BASE_URL=http://localhost:5000
